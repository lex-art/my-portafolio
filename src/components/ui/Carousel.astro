---
import HtmlIcon from "../Icons/Logos/HtmlIcon.astro";
import CssIcon from "../Icons/Logos/CssIcon.astro";
import JsIcon from "../Icons/Logos/JsIcon.astro";
import ReactIcon from "../Icons/Logos/ReactIcon.astro";
import NestJsIcon from "../Icons/Logos/NestJsIcon.astro";
import NextJs from "../Icons/Logos/NextJs.astro";
import ReduxIcon from "../Icons/Logos/ReduxIcon.astro";
import GraphQLIcon from "../Icons/Logos/GraphQLIcon.astro";
import GitIcon from "../Icons/Logos/GitIcon.astro";
import PostgresIcon from "../Icons/Logos/PostgresIcon.astro";
import MySqlIcon from "../Icons/Logos/MySqlIcon.astro";
import AswIcon from "../Icons/Logos/AswIcon.astro";
// import BitriseIcon from "../Icons/Logos/BitriseIcon.astro";
import DatadogIcon from "../Icons/Logos/DatadogIcon.astro";
import PythonIcon from "../Icons/Logos/PythonIcon.astro";
import DjangoIcon from "../Icons/Logos/DjangoIcon.astro";
import TsIcon from "../Icons/Logos/TsIcon.astro";
import AIIcon from "../Icons/Logos/AIIcon.astro";
import PSIcon from "../Icons/Logos/PSIcon.astro";
import FigmaIcon from "../Icons/Logos/FigmaIcon.astro";
import AstroIcon from "../Icons/Logos/AstroIcon.astro";

const dataIcons = [
  TsIcon,
  JsIcon,
  ReactIcon,
  NestJsIcon,
  NextJs,
  ReduxIcon,
  GraphQLIcon,
  GitIcon,
  AstroIcon,
  DatadogIcon,
  PostgresIcon,
  MySqlIcon,
  AswIcon,
  HtmlIcon,
  CssIcon,
  PythonIcon,
  DjangoIcon,
  AIIcon,
  PSIcon,
  FigmaIcon,
];
---

<div class="relative overflow-hidden w-full max-w-60 md:max-w-xl mx-auto m-2">
  <!-- Contenedor del carrusel -->
  <div
    class="flex transition-transform duration-1000 ease-in-out"
    id="carousel"
  >
    {
      dataIcons.map((Icon, index) => (
        <div
          class={`flex justify-center items-center p-4 h-32 w-full handle-width min-w-[50%] md:min-w-[20%]`}
        >
          <div class="size-16 w-16 h-16 dark:opacity-50">
            <Icon class="fill-current text-[#229379] dark:text-[#f4f4f4]" />
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.getElementById("carousel");
    const iconsPerView = getIconsPerView();
    let currentIndex = 0;

    function getIconsPerView() {
      if (window.innerWidth < 640) return 3; // Móviles
      if (window.innerWidth < 1024) return 2; // Tablets
      return 5; // Escritorio
    }

    const slide = () => {
      const items = carousel?.children;
      const totalItems = items?.length || 0;

      // Calcula el total de pasos basados en los íconos visibles
      const totalSteps = Math.ceil(totalItems / iconsPerView);

      // Actualiza el índice del paso
      currentIndex = (currentIndex + 1) % totalSteps;

      // Calcula el desplazamiento basado en el índice actual
      const offset = -currentIndex * 100;
      if (carousel) {
        carousel.style.transform = `translateX(${offset}%)`;
      }
    };

    // Cambia de grupo de íconos cada 3 segundos
    setInterval(slide, 3000);
  });
</script>
