---
import { useI18Translations } from "../i18n/utils";
import { social } from "../data/site";

const { t } = useI18Translations(Astro.url);
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <span>
      © {currentYear}
      <a class="nav-link" href="https://alexander-dev.com/">lex-art</a>
    </span>
    <nav class="footer-links">
      <a class="nav-link" href="#profile">{t("header.about")}</a>
      <a class="nav-link" href={social.email}>{t("header.contact")}</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    padding: calc(2 * var(--leading)) 0;
    font-size: 13px;
    line-height: var(--leading);
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--edge);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--half);
  }

  .footer-links {
    display: flex;
    gap: var(--leading);
  }
</style>
