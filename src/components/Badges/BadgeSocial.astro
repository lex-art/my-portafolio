---
const { href, ...rest } = Astro.props;
---

<a
  href={href}
  {...rest}
  target="_blank"
  rel="noopener noreferrer"
  class="btn btn-secondary badge-social"
>
  <slot />
</a>

<style>
  .badge-social {
    font-size: 13px;
    gap: 8px;
  }

  /* Size only — the icons set their own fill/stroke, and forcing a fill here
     would flood the stroke-drawn ones (Instagram, LinkedIn) into blobs. */
  .badge-social :global(svg) {
    width: 18px;
    height: 18px;
  }
</style>
