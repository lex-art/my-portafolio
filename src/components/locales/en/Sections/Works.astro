---
import { Image } from "astro:assets";
import Team from "../../../Icons/Team.astro";
---

<div
  class="flex min-h-dvh w-full items-center justify-center flex-col gap-8 p-14"
>
  <div class="flex gap-4 flex-col items-center md:flex-row md:items-start">
    <div id="works-together" class="w-full md:w-6/12">
      <h1
        class="font-slackey text-4xl mb-4 text-[#1b3e65] dark:text-yellow-300 tracking-wide"
      >
        Let´s work together<span class="text-cyan-400">.</span>
      </h1>
      <p class="text-xl leading-relaxed font-[200] text-pretty">
        From the conception of the idea to the implementation, with scalable and
        maintainable applications, attractive and accessible design that fits
        your needs.
        <!-- I help people and companies build ambitious and quality
        projects. -->
      </p>
    </div>
    <div class="w-6/12 flex items-center justify-center">
      <div
        id="image-works-0"
        class="hover:scale-105 transition-all ease-in-out duration-700 rotate-2"
      >
        <Image
          class="rounded-lg rotate-0"
          src={import.meta.env.BASE_URL + "img/profile.webp"}
          alt="Trabajos"
          width={250}
          height={200}
          loading="lazy"
        />
      </div>
    </div>
  </div>
  <div
    class="flex gap-4 flex-col items-center md:flex-row-reverse md:items-start"
  >
    <div id="works-together-2" class="w-full md:w-6/12">
      <h1
        class="font-slackey text-4xl mb-4 text-[#1b3e65] dark:text-yellow-300 tracking-wide"
      >
        Business success<strong class="text-cyan-400">.</strong>
      </h1>
      <p class="text-xl leading-relaxed font-[200] text-pretty">
        One of my greatest achievements was to automate the processes of a
        logistics company, implementing package tracking through different
        states and notifying customers efficiently.
      </p>
      <a
        href="https://tikalbox.app"
        target="_blank"
        class="inline-flex mt-2 items-center px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-100 focus:text-blue-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700"
      >
        Learn more...{" "}
        <svg
          class="w-3 h-3 ms-2 rtl:rotate-180"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 14 10"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 5h12m0 0L9 1m4 4L9 9"></path>
        </svg>
      </a>
    </div>
    <div
      id="image-works-1"
      class="w-full md:w-6/12 flex items-center justify-center hover:scale-105 transition-all ease-in-out duration-700 rotate-2"
    >
      <Image
        class="rounded-lg shadow-lg"
        src={import.meta.env.BASE_URL + "img/projects/project-tb.webp"}
        alt="Trabajos"
        width={300}
        height={200}
        loading="lazy"
      />
    </div>
  </div>
  <div class="flex gap-4 flex-col items-center md:flex-row md:items-start">
    <div id="works-together-3" class="w-full md:w-6/12">
      <h1
        class="font-slackey text-4xl mb-4 text-[#1b3e65] dark:text-yellow-300 tracking-wide"
      >
        Currently working<strong class="text-cyan-400">.</strong>
      </h1>
      <p class="text-xl leading-relaxed font-[200]">
        As a frontend developer at <strong>Zigi App</strong>, a 100% digital and
        Guatemalan financial application, I contribute to offering users the
        possibility of making financial transactions quickly and safely.
      </p>
      <a
        href="https://zigi.app"
        target="_blank"
        class="inline-flex mt-2 items-center px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-100 focus:text-blue-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700"
      >
        Learn more...{" "}
        <svg
          class="w-3 h-3 ms-2 rtl:rotate-180"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 14 10"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 5h12m0 0L9 1m4 4L9 9"></path>
        </svg>
      </a>
    </div>
    <div
      id="image-works-2"
      class="w-full md:w-6/12 flex items-center justify-center hover:scale-105 transition-all ease-in-out duration-700 -rotate-2"
    >
      <Image
        class="rounded-lg shadow-lg"
        src={import.meta.env.BASE_URL + "img/projects/714_1x_shots_so.webp"}
        alt="Trabajos"
        width={300}
        height={200}
        loading="lazy"
      />
    </div>
  </div>
</div>

<script src="../../../../scripts/animation-works.ts"></script>
