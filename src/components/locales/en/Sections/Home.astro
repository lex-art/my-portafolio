---
import { Image } from "astro:assets";
import MetricCars from "../../../ui/MetricCars.astro";
import Badge from "../../../Badges/Badge.astro";

const metric = [
  {
    value: 5,
    description: "Years of experience",
  },
  {
    value: 10,
    description: "Projects completed",
  },
  {
    value: 318,
    description: "Contributions on GitHub",
  },
  {
    value: 15,
    description: "Technologies mastered",
  },
];
---

<div class="w-full py-28 md:py-28 px-4">
  <h2
    id="box"
    style="letter-spacing: 2px;"
    class="text-5xl text-center -rotate-2 pb-6 text-[#143258] dark:dark:text-[#7eeb54] font-just-another-hand"
  >
    👋🏽 Aloha! I´m Alexander
  </h2>
  <div
    class="flex flex-col md:flex-col-reverse lg:flex-row gap-10 justify-center items-center"
  >
    <h1
      id="main-title"
      class="font-slackey text-4xl md:text-7xl xl:text-7xl text-center lg:text-left dark:text-cyan-200 text-pretty [&>span]:text-[#1b3e65] [&>span]:dark:text-yellow-300"
    >
      I <span id="title-part-1">Like</span> to bring <span id="title-part-2"
        >ideas</span
      > to life through <span id="title-part-3">code</span> and <span
        id="title-part-4">design.</span
      >
    </h1>
    <Image
      class="rounded-full object-fill object-center p-[2px] size-1/4 drop-shadow-[0_10px_10px_rgba(255,255,255,0.5)]"
      src={import.meta.env.BASE_URL + "img/toy.webp"}
      alt="Alexander"
      width={250}
      height={250}
      loading="eager"
    />
  </div>
  <div class="flex justify-center flex-wrap h-full w-full gap-8 mt-4">
    {metric.map((item) => <MetricCars {...item} />)}
  </div>

  <div class="flex items-center justify-center mt-4">
    <a
      class="flex transition justify-center md:justify-start hover:scale-105 m-3"
      href="mailto:ochanaxo@gmail.com"
      target="_blank"
      rel="noopener"
    >
      <Badge>
        Do you have a project in mind? <svg
          class="w-3 h-3 ms-2 rtl:rotate-180"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 14 10"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 5h12m0 0L9 1m4 4L9 9"></path>
        </svg></Badge
      >
    </a>
  </div>
</div>

<script src="../../../../scripts/animation-title.ts"></script>
