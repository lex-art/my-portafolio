---
import { Image } from "astro:assets";
import Badge from "../../../Badges/Badge.astro";
import BadgeSocial from "../../../Badges/BadgeSocial.astro";
import LinkedInIcon from "../../../Icons/LinkedInIcon.astro";
import InstagramIcon from "../../../Icons/InstagramIcon.astro";
import MailIcon from "../../../Icons/MailIcon.astro";
import Carousel from "../../../ui/Carousel.astro";
---

<div
  class="flex min-h-dvh w-full items-center justify-center flex-col gap-20 p-8"
>
  <div>
    <div id="title-about">
      <h1 class="text-5xl md:text-6xl font-bold font-slackey">
        🙋🏽‍♂️ <span class="text-green-700 dark:text-yellow-300">Alexander</span> aquí!
      </h1>
    </div>

    <h3 id="about-me-subtitle" class="font-light text-lg mt-5">
      <span>
        M.A. en Seguridad Informática (C. L.) <strong
          class="text-green-700 dark:text-yellow-300">|</strong
        > Ingeniero en Sistemas <strong
          class="text-green-700 dark:text-yellow-300">|</strong
        >
        Desarrollador de Software
      </span>
    </h3>
    <nav class="flex flex-wrap mt-5 gap-4">
      <BadgeSocial href="mailto:ochanaxo@gmail.com"
        ><MailIcon />Email</BadgeSocial
      >
      <BadgeSocial href="https://www.linkedin.com/in/oscar-chanax-82b5691b9/"
        ><LinkedInIcon />LinkedIn</BadgeSocial
      >
      <BadgeSocial href="https://www.instagram.com/alexanderdev_/">
        <InstagramIcon />
        Instagram</BadgeSocial
      >
    </nav>
    <div
      id="text-about"
      class="[&>p]:text-lg [&>p]:mt-5 [&>p>strong]:text-[#1b3e65] [&>p>strong]:dark:text-yellow-300 text-pretty"
    >
      <p class="font-[300]">
        Originario de <strong>🇬🇹</strong> ,<strong>
          +5 años de experiencia en el campo del desarrollo de software,</strong
        > especializado en desarrollo web, desarrollo móvil y ciberseguridad. <strong
          >Ayudo a personas y empresas a construir productos digitales de
          calidad y accesibles.</strong
        >
      </p>
      <p class="font-[300]">
        Empece en la <strong>programación desde la universidad.</strong> Esto, combinado
        con
        <strong>conocimientos en diseño gráfico</strong>, me permitió tener una
        visión más amplia de cómo se puede combinar el <strong
          >diseño con la programación para crear productos digitales innovadores
          y funcionales.</strong
        >
      </p>
      <p class="font-[300]">
        No dudes en contactarme si <strong
          >tienes alguna idea o proyecto en mente,</strong
        > o participar en un proyecto <strong
          >donde pueda aportar mis conocimientos y habilidades.</strong
        >
      </p>
    </div>

    <Carousel />
  </div>
</div>
<script src="../../../../scripts/animation-about.ts"></script>
