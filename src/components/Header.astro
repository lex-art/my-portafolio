---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import { languages } from "../i18n/ui";
import Dark from "../icons/Dark.astro";
import Light from "../icons/Light.astro";
import LanguagePicker from "./LanguagePicker.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto p-4 backdrop-blur"
>
  <nav class="flex flex-row gap-x-10">
    <a href={translatePath("/about/")}>{t("nav.home")}</a>
    <a href="#">{t("nav.about")}</a>
    <a href="#">Projects</a>
    <a href="#">Contact</a>
    <!-- {
      lang === "es" ? (
        <a href={translatePath("/", lang)}>EN</a>
      ) : (
        <a href={translatePath("/", lang)}>ES</a>
      )
    } -->
    <LanguagePicker />
    <button
      id="theme-toggle"
      type="button"
      class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-x-3"
    >
      <Dark />
      <Light />
    </button>
  </nav>
</header>
<script>
  function applyTheme() {
    var themeToggleDarkIcon = document.getElementById("theme-toggle-dark-icon");
    var themeToggleLightIcon = document.getElementById(
      "theme-toggle-light-icon"
    );
    // Aplica el tema desde localStorage
    if (
      localStorage.getItem("color-theme") === "dark" ||
      (!("color-theme" in localStorage) &&
        window.matchMedia("(prefers-color-scheme: dark)").matches)
    ) {
      document.documentElement.classList.add("dark");
      themeToggleLightIcon?.classList.remove("hidden");
      themeToggleDarkIcon?.classList.add("hidden");
    } else {
      document.documentElement.classList.remove("dark");
      themeToggleDarkIcon?.classList.remove("hidden");
      themeToggleLightIcon?.classList.add("hidden");
    }

    // Manejo del botón de cambio de tema
    var themeToggleBtn = document.getElementById("theme-toggle");
    themeToggleBtn?.addEventListener("click", function () {
      // Alterna visibilidad de los íconos
      themeToggleDarkIcon?.classList.toggle("hidden");
      themeToggleLightIcon?.classList.toggle("hidden");

      // Cambia el tema y guarda en localStorage
      if (localStorage.getItem("color-theme") === "dark") {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("color-theme", "light");
      } else {
        document.documentElement.classList.add("dark");
        localStorage.setItem("color-theme", "dark");
      }
    });
  }
  applyTheme();
  document.addEventListener("astro:after-swap", applyTheme);
</script>
