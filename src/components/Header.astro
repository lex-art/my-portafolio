---
import { useI18Translations } from "../i18n/utils";
import Dark from "../icons/Dark.astro";
import Light from "../icons/Light.astro";
import LanguagePicker from "./LanguagePicker.astro";

const { t, lang } = useI18Translations(Astro.url);
---

<header class="masthead">
  <nav class="nav">
    <a class="nav-brand" href="#about">Alexander</a>
    <a class="nav-link" href="#about">{t("header.home")}</a>
    <a class="nav-link" href="#experience">{t("header.works")}</a>
    <a class="nav-link" href="#profile">{t("header.about")}</a>
    <a class="nav-link" href="#career">{t("header.projects")}</a>
    <a
      class="btn btn-secondary nav-cv"
      href={`${import.meta.env.BASE_URL}pdf/oscar_chanax_cv_${lang}.pdf`}
      download>{t("header.downloadCV")}</a
    >
    <LanguagePicker />
    <button
      id="theme-toggle"
      type="button"
      class="btn btn-icon btn-ghost theme-toggle"
    >
      <span class="sr-only">Theme</span>
      <Dark class="theme-icon theme-icon-dark" />
      <Light class="theme-icon theme-icon-light" />
    </button>
  </nav>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    backdrop-filter: blur(12px);
  }

  /* The masthead's contents take the page gutter and sit on the content
     column's text axis. */
  .nav {
    display: flex;
    align-items: center;
    gap: 18px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 12px var(--edge);
  }

  .nav-brand {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 18px;
    color: inherit;
    text-decoration: none;
    margin-right: auto;
  }

  .nav-link {
    white-space: nowrap;
  }

  /* Which icon shows follows the theme class the Layout resolves before
     first paint, so the toggle is correct without waiting on a script. */
  .theme-icon {
    width: 18px;
    height: 18px;
  }

  .theme-icon-light,
  :global(html.dark) .theme-icon-dark {
    display: none;
  }

  :global(html.dark) .theme-icon-light {
    display: block;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Phone width: the masthead keeps the brand and controls; the link row
     folds away rather than wrapping into a second line. */
  @media (max-width: 720px) {
    .nav-link,
    .nav-cv {
      display: none;
    }
  }
</style>

<script is:inline>
  function smoothScrollTo(target, duration = 450) {
    const targetElement = document.querySelector(target);
    if (!targetElement) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      targetElement.scrollIntoView();
      return;
    }

    const startPosition = window.scrollY;
    const distance = targetElement.offsetTop - startPosition;
    let startTime = null;

    function easeInOutQuad(t, b, c, d) {
      t /= d / 2;
      if (t < 1) return (c / 2) * t * t + b;
      t--;
      return (-c / 2) * (t * (t - 2) - 1) + b;
    }

    function step(currentTime) {
      if (startTime === null) startTime = currentTime;
      const elapsed = currentTime - startTime;
      window.scrollTo(0, easeInOutQuad(elapsed, startPosition, distance, duration));
      if (elapsed < duration) requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  }

  function attachSmoothScroll() {
    document.querySelectorAll('a[href^="#"]').forEach((element) => {
      element.addEventListener("click", (e) => {
        e.preventDefault();
        const target = element.getAttribute("href");
        if (target && target !== "#") smoothScrollTo(target);
      });
    });
  }

  attachSmoothScroll();
  document.addEventListener("astro:after-swap", attachSmoothScroll);
</script>

<script>
  // The Layout resolves the theme before first paint and CSS picks the icon,
  // so this only has to record the user's choice on click.
  function bindThemeToggle() {
    document
      .getElementById("theme-toggle")
      ?.addEventListener("click", function () {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
  }

  bindThemeToggle();
  document.addEventListener("astro:after-swap", bindThemeToggle);
</script>
