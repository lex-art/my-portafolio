---
import { Image } from "astro:assets";
import { useI18Translations } from "../../i18n/utils";
import BriefcaseIcon from "../Icons/BriefcaseIcon.astro";
const { t } = useI18Translations(Astro.url);

const data = [
  {
    title: "Frontend - ZIGI APP",
    date: "Febrero 2024 - Presente",
    description:
      "Desarrollador frontend en Zigi App, una aplicación financiera 100% digital y Guatemalteca que permite a los usuarios realizar transacciones financieras de forma rápida y segura, en mi rol como desarrollador implemento nuevas funcionalidades, retención de clientes utilizando tecnologías modernas.",
    link: "https://zigi.app",
    image: import.meta.env.BASE_URL + "img/projects/580_2x_shots_so.webp",
  },
  {
    title: "Fullstack - Netcurio",
    date: "Febrero 2022-2024",
    description:
      "Desarrollador fullstack en Netcurio una plataforma Mexicana de Software as a Service (SaaS) desarrollada y alojada en AWS, que utiliza los más altos estándares de ingeniería y calidad. Desarrollé nuevas funcionalidades, corregí errores, y realice mantenimiento en la plataforma. Desencadenando un aumento en la satisfacción del cliente y la retención de los mismos.",
    link: "https://netcurio.com",
    image: import.meta.env.BASE_URL + "img/projects/216_2x_shots_so.webp",
  },
  {
    title: "Fullstack - Ciancoders",
    date: "Febrero 2021-2022",
    description:
      "Desarrollador fullstack en Ciancoders, una empresa de desarrollo de software en Guatemala, participe en multiples proyectos, desarrollando aplicaciones webs y apps móviles híbridas, esto me permitió mejorar mis habilidades de desarrollo, trabajar en equipo, atención al cliente, manejo de proyectos y liderazgo.",
    link: "https://ciancoders.com",
    image: import.meta.env.BASE_URL + "img/projects/695_2x_shots_so.webp",
  },
  {
    title: "Freelance",
    date: "Febrero 2019-Presente",
    description:
      "Desarrollador freelance, he trabajado en varios proyectos independientes, desarrollando aplicaciones web y apps híbridas, algunas de las empresas con las que he trabajado son: Pistillo proyecto de Agencia de Ocote (Guatemala), una app que ayuda a buscar atención ginecológica. Tikalbox (Miami - Guatemala) una plataforma de envíos de paquetes a Guatemala.",
    image: import.meta.env.BASE_URL + "img/projects/600_2x_shots_so-1.webp",
    link: "https://tikalbox.app",
  },
];
---

<div class="min-h-dvh p-2">
  <div class="flex gap-3 items-end pb-10 pt-20">
    <BriefcaseIcon class="size-12" />
    <h1 class="text-3xl">{t("common.experienceTitle")}</h1>
  </div>
  <div class="flex items-center">
    <ol>
      {
        data.map((item, index) => (
          <li class="flex gap-4 justify-end  transition-all ">
            <div class="max-w-[300px] w-[300px]">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                {item.title}
              </h3>
              <div class="w-52 pt-4">
                {item.image && (
                  <Image
                    class="rounded-lg aspect-auto hover:scale-110 transition-all "
                    src={item.image}
                    alt={item.title}
                    width={300}
                    height={300}
                    loading="lazy"
                  />
                )}
              </div>
            </div>
            <div class="relative border-s border-[#229379] dark:border-[#bcfffb]">
              <div class="mb-10 ms-4">
                <div class="absolute w-3 h-3 bg-[#229379] dark:bg-yellow-300 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900" />
                <time class="mb-1 text-sm font-normal leading-none text-[#229379] dark:text-[#bcfffb]">
                  {item.date}
                </time>

                <p class="mb-4 text-base font-normal text-gray-500 dark:text-gray-400 ">
                  {item.description}
                </p>
                {item.link && (
                  <a
                    href={item.link}
                    target="_blank"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-100 focus:text-blue-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700"
                  >
                    Visitar{" "}
                    <svg
                      class="w-3 h-3 ms-2 rtl:rotate-180"
                      aria-hidden="true"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 14 10"
                    >
                      <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M1 5h12m0 0L9 1m4 4L9 9"
                      />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</div>
