---
import { Image } from "astro:assets";
import MetricCars from "../MetricCars.astro";

const metric = [
  {
    value: 5,
    description: "Años de experiencia",
  },
  {
    value: 10,
    description: "Proyectos completados",
  },
  {
    value: 318,
    description: "Contribuciones en GitHub",
  },
  {
    value: 15,
    description: "Tecnologías dominadas",
  },
];
---

<div class="w-full py-28 md:py-28 px-4">
  <h2
    id="box"
    style="letter-spacing: 2px;"
    class="text-5xl text-center -rotate-2 pb-6 text-[#143258] dark:dark:text-[#7eeb54] font-just-another-hand"
  >
    👋🏽 Aloha! Soy Alexander
  </h2>
  <div class="flex flex-col lg:flex-row gap-10 justify-center items-center">
    <Image
      class="rounded-full object-fill object-center p-[2px] size-96"
      src={import.meta.env.BASE_URL + "img/toy.svg"}
      alt="Alexander"
      width={250}
      height={250}
      loading="eager"
    />

    <h1
      id="main-title"
      class="font-slackey text-4xl md:text-7xl xl:text-8xl text-center lg:text-left dark:text-cyan-200 md:leading-[6.5rem] text-pretty [&>span]:text-[#1b3e65] [&>span]:dark:text-yellow-300"
    >
      Me <span id="title-part-1">gusta</span> darle vida a las <span
        id="title-part-2">ideas</span
      > a <span id="title-part-3">través</span> del código y el <span
        id="title-part-4">diseño.</span
      >
    </h1>
  </div>
  <div class="flex justify-center flex-wrap h-full w-full gap-8 m-3">
    {metric.map((item) => <MetricCars {...item} />)}
  </div>
</div>

<script src="../../scripts/animation-title.ts"></script>
