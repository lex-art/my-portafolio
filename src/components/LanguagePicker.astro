---
import { Image } from "astro:assets";
import { languages } from "../i18n/ui";
import { useI18Translations } from "../i18n/utils";

const { t, navigate } = useI18Translations(Astro.url);
---

<div class="relative">
  <button
    transition:persist
    id="language-picker"
    class="btn btn-icon btn-ghost"
  >
    <span class="sr-only">{t("header.chooseLanguage")}</span>
    <span
      id="spanish"
      class="lng-toggle-text"
    >
      <!-- 🇬🇹 -->
      <Image
        src={import.meta.env.BASE_URL + "img/flags/gt.png"}
        alt="Guatemala"
        width={24}
        height={24}
        loading="lazy"
      />
    </span>
    <span
      id="english"
      class="lng-toggle-text hidden"
    >
      <!-- 🇺🇸 -->
      <!--     <UnitedStatesIcon /> -->
      <Image
        src={import.meta.env.BASE_URL + "img/flags/us.png"}
        alt="United States"
        width={24}
        height={24}
        loading="eager"
      />
    </span>
  </button>
  <div
    transition:persist="true"
    id="language-picker-menu"
    class="hidden lang-menu"
  >
    <ul>
      {
        Object.entries(languages).map(([lang, label]) => (
          <li
            class="themes-menu-option"
            data-lang={lang}
          >
            <a class="block w-full h-full" href={navigate("/", lang)}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .lang-menu {
    position: absolute;
    top: 42px;
    right: 0;
    z-index: 30;
    min-width: 8rem;
    padding: 4px;
    font-size: 13px;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .lang-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .themes-menu-option {
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .themes-menu-option:hover {
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
    color: var(--color-accent);
  }

  .themes-menu-option a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .lng-toggle-text {
    display: flex;
  }

  .lng-toggle-text.hidden {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script is:inline>
  // Variables globales
  const menu = document.getElementById("language-picker-menu");
  const button = document.getElementById("language-picker");
  const spanish = document.getElementById("spanish");
  const english = document.getElementById("english");
  // La URL manda: el idioma mostrado es el de la ruta, no el guardado.
  // (Antes se redirigía la ruta para que coincidiera con localStorage, lo que
  // hacía inalcanzable /en/ cuando había "es" guardado.)
  const segment = window.location.pathname.split("/")[1];
  const currentLang = segment === "en" ? "en" : "es";
  let savedLang = currentLang;
  localStorage.setItem("lang", currentLang);

  // Función para actualizar el idioma visual
  const updateLanguageDisplay = () => {
    if (savedLang === "es") {
      spanish.classList.remove("hidden");
      english.classList.add("hidden");
    } else {
      spanish.classList.add("hidden");
      english.classList.remove("hidden");
    }
  };

  // Función para abrir/cerrar el menú
  const toggleMenu = () => {
    menu.classList.toggle("hidden");
  };

  // Función para cambiar el idioma
  const changeLanguage = (lang) => {
    savedLang = lang;
    localStorage.setItem("lang", lang);
    updateLanguageDisplay();
    menu.classList.add("hidden"); // Cierra el menú
    const path = window.location.pathname.replace(/^\/(es|en)/, "");
    const newPath = lang === "es" ? path : `/${lang}${path}`;
    window.location.href = newPath || "/";
  };

  // Actualiza el idioma inicial
  updateLanguageDisplay();

  // Listener para abrir/cerrar el menú al hacer clic en el botón
  button.addEventListener("click", (e) => {
    e.stopPropagation(); // Evita que el clic cierre el menú
    toggleMenu();
  });

  // Listener para seleccionar un idioma
  menu.addEventListener("click", (e) => {
    const target = e.target.closest(".themes-menu-option");
    if (target) {
      const lang = target.dataset.lang;
      if (lang) changeLanguage(lang);
    }
  });

  // Listener para cerrar el menú al hacer clic fuera de él
  document.addEventListener("click", (e) => {
    if (menu && !menu.contains(e.target) && !button.contains(e.target)) {
      menu.classList.add("hidden");
    }
  });
</script>
