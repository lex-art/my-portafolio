---
import { Image } from "astro:assets";
import { useI18Translations } from "../../i18n/utils";
import { social } from "../../data/site";
import BadgeSocial from "../Badges/BadgeSocial.astro";
import GitIcon from "../Icons/Logos/GitIcon.astro";
import LinkedInIcon from "../Icons/LinkedInIcon.astro";
import InstagramIcon from "../Icons/InstagramIcon.astro";

const { t } = useI18Translations(Astro.url);

// Split on the server so the words exist in the HTML: crawlers and screen
// readers get the full sentence whether or not the reveal script runs.
const line1 = t("home.hero.line1").split(" ");
const line2 = t("home.hero.line2").split(" ");
---

<section class="hero" id="about">
  <div class="hero-copy">
    <span class="kicker">{t("home.hero.greeting")}</span>
    {/* Display headers break per sentence: each line begins its own clause.
        The per-word spans are purely presentational — aria-label carries the
        sentence so assistive tech reads it as prose, not as a word list. */}
    <h1
      id="main-title"
      class="display"
      aria-label={`${t("home.hero.line1")} ${t("home.hero.line2")}`}
    >
      {/* --sheen-i staggers each word's sheen so the light reads as one band
          crossing the headline, not as every word flashing at once. */}
      <span class="line" aria-hidden="true">
        {
          line1.map((word, i) => (
            <span class="word" data-word={word} style={`--sheen-i:${i}`}>
              {word}
            </span>
          ))
        }
      </span>
      <span class="line" aria-hidden="true">
        {
          line2.map((word, i) => (
            <span
              class="word"
              data-word={word}
              style={`--sheen-i:${line1.length + i}`}
            >
              {word}
            </span>
          ))
        }
      </span>
    </h1>
    <p class="sub">{t("home.hero.sub")}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={social.email} rel="noopener">
        {t("home.hero.ctaPrimary")}
        <svg
          class="size-3"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 14 10"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 5h12m0 0L9 1m4 4L9 9"></path>
        </svg>
      </a>
      <a class="btn btn-ghost" href="#profile">{t("home.hero.ctaSecondary")}</a>
    </div>
    <nav class="hero-social" aria-label="Social">
      <BadgeSocial href={social.github}>
        <GitIcon width="18" height="18" fill="currentColor" />
        GitHub
      </BadgeSocial>
      <BadgeSocial href={social.linkedin}>
        <LinkedInIcon />
        LinkedIn
      </BadgeSocial>
      <BadgeSocial href={social.instagram}>
        <InstagramIcon />
        Instagram
      </BadgeSocial>
    </nav>
  </div>

  <figure class="hero-figure lighten">
    <Image
      class="hero-portrait"
      src={import.meta.env.BASE_URL + "img/toy.webp"}
      alt="Oscar Alexander Chanax"
      width={320}
      height={320}
      loading="eager"
    />
  </figure>
</section>

<style>
  /* Layouts hug the left edge and leave the right to air. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--leading) clamp(24px, 5vw, 96px);
    align-items: center;
    padding: calc(4 * var(--leading)) 0 calc(3 * var(--leading));
  }

  .display {
    font-size: clamp(40px, 5.6vw, 76px);
    /* Tight display leading, ratio-governed (~1.11) rather than snapped to
       the 28px lattice — the display-block exemption. */
    line-height: 1.11;
    letter-spacing: -0.015em;
    margin: 0;
    /* Optical left alignment: Inter's wide flat-stem bearings. */
    margin-left: -0.06em;
  }

  .display .line {
    display: block;
  }

  /* Words must be inline-block to take a transform; the right margin stands
     in for the collapsed whitespace between them. */
  .display .word {
    display: inline-block;
    margin-right: 0.24em;
  }

  .display .word:last-child {
    margin-right: 0;
  }

  /* The hidden state is applied by script, never here, so the headline is
     readable if the bundle fails. .is-staged is set synchronously before
     paint by the inline script below. */
  .display.is-staged .word {
    opacity: 0;
    transform: translateY(6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .display.is-staged .word {
      opacity: 1;
      transform: none;
    }
  }

  /* — sheen —
     A band of light crosses the headline on a loop. The gradient paints the
     glyphs themselves via background-clip, so nothing overlays the text and
     the ink never drops below its normal value: the band only lightens
     toward the accent, then returns. The type stays fully legible at every
     frame of the cycle.

     Applied per line so each line's gradient spans its own width — one
     gradient across the block would sweep the short line too fast. */
  /* The line keeps its normal ink and stays fully painted at all times. The
     travelling light is a SEPARATE layer, drawn by a pseudo-element that
     duplicates the text and is clipped to the glyphs — so if the clip, the
     gradient or the animation misbehaves, the headline underneath is
     untouched. (Clipping the line itself to a moving gradient does not
     survive: once the gradient leaves the box, background-clip: text has
     nothing to paint and the words vanish.) */
  .display.is-lit .line {
    position: relative;
  }

  .display.is-lit .word {
    position: relative;
  }

  .display.is-lit .word::after {
    content: attr(data-word);
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* --sheen-ink is the colour the band paints: on the dark ground it
       lightens toward the accent, on paper it deepens toward it. Either way
       the band moves AWAY from the base ink, so the sweep is visible in both
       themes and never washes the text out. */
    background-image: linear-gradient(
      100deg,
      transparent 0,
      transparent 40%,
      var(--sheen-ink) 50%,
      transparent 60%,
      transparent 100%
    );
    background-repeat: no-repeat;
    background-size: 320% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sheen 5s ease-in-out infinite;
    animation-delay: calc(var(--sheen-i, 0) * 0.07s);
  }

  @keyframes sheen {
    /* The sweep occupies the first ~36% of the cycle; the rest is the pause
       that keeps this from reading as constant motion. The band is fully
       transparent at rest, so the base ink shows through unchanged. */
    0% {
      background-position: 118% 0;
    }
    36%,
    100% {
      background-position: -18% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .display.is-lit .word::after {
      display: none;
    }
  }

  /* The hero is one cluster: tight single-unit gaps inside, generous air
     between sections. */
  .sub {
    font-size: 17px;
    line-height: var(--leading);
    max-width: var(--measure);
    margin: calc(1.5 * var(--leading)) 0 0;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: var(--leading);
  }

  .hero-social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--leading);
  }

  .hero-figure {
    margin: 0;
    justify-self: center;
  }

  .hero-portrait {
    border-radius: 50%;
    width: min(320px, 100%);
    height: auto;
    object-fit: cover;
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: calc(2.5 * var(--leading));
    }
    .hero-figure {
      order: -1;
      justify-self: start;
    }
    .hero-portrait {
      width: min(170px, 46%);
    }
  }
</style>

{/* Stage the words before first paint, so they never flash in at full
    opacity and then re-animate. Inline and synchronous by design. */}
<script is:inline>
  (() => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const title = document.getElementById("main-title");
    if (title) title.classList.add("is-staged");
  })();
</script>

<script>
  import { animate } from "motion";

  function revealHeadline() {
    const title = document.getElementById("main-title");
    if (!title) return;

    const words = Array.from(title.querySelectorAll<HTMLElement>(".word"));
    if (words.length === 0) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Whatever happens next, the staged state must come off the element.
    title.classList.remove("is-staged");

    if (reduced) {
      words.forEach((word) => {
        word.style.opacity = "";
        word.style.transform = "";
      });
      return;
    }

    // The class carried the hidden state; move it inline before clearing it,
    // so the words do not flash visible in the frame before the animation.
    words.forEach((word) => {
      word.style.opacity = "0";
      word.style.transform = "translateY(6px)";
    });

    words.forEach((word, index) => {
      animate(
        word,
        { opacity: 1, transform: "translateY(0px)" },
        { delay: index * 0.045, duration: 0.5, ease: "easeOut" }
      );
    });

    // The sheen paints the glyphs with background-clip, which needs the
    // words at full opacity to look right — start it only once the reveal
    // has finished, never during it.
    const revealEnd = ((words.length - 1) * 0.045 + 0.5) * 1000;
    window.setTimeout(() => title.classList.add("is-lit"), revealEnd + 400);
  }

  revealHeadline();
  document.addEventListener("astro:after-swap", revealHeadline);
</script>
