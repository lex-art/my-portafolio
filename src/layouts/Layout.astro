---
// Supports weights 100-900
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/dm-sans/opsz.css";
import "@fontsource-variable/dm-sans/opsz-italic.css";
import "@fontsource/slackey";
import "@fontsource/just-another-hand";
import "../styles.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  keyWords: string;
}

const { title, description, keyWords } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-favicon.png" />
    <link rel="icon" href="/apple-favicon.png" sizes="any" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Oscar Chanax" />
    <meta name="keywords" content={keyWords} />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content="https://alexander-dev.com" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Alexander dev - Desarrollador y programador web con mas de 5 años de experiencia"
    />
    <meta
      property="og:description"
      content="Contacta con Oscar Alexander para cualquier proyecto web, desarrollo de aplicaciones, diseño web, etc. Especializado en crear soluciones tecnológicas a medida."
    />
    <meta
      property="og:image"
      content="https://alexander-dev.com/img/profile-toy.webp"
    />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="alexander-dev.com" />
    <meta property="twitter:url" content="https://alexander-dev.com" />
    <meta
      name="twitter:title"
      content="Alexander dev - Desarrollador y programador web con mas de 5 años de experiencia"
    />
    <meta
      name="twitter:description"
      content="Contacta con Oscar Alexander para cualquier proyecto web, desarrollo de aplicaciones, diseño web, etc. Especializado en crear soluciones tecnológicas a medida."
    />
    <meta
      name="twitter:image"
      content="https://alexander-dev.com/img/profile-toy.webp"
    />

    <!-- Meta Tags Generated via https://www.opengraph.xyz -->
    <ClientRouter />
  </head>
  <body
    class="relative text-[#229379] dark:text-[#bcfffb] h-full w-full bg-slate-100 dark:bg-slate-900 block"
  >
    <div
      id="background-light"
      class="absolute -z-50 bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_0%,#000_70%,transparent_110%)]"
    >
    </div>
    <div
      id="background-dark"
      class="fixed top-0 z-[-2] h-dvh w-dvw bg-slate-900 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
      <div class="fixed top-0 left-0 w-full h-screen m-0 p-0 -z-10">
        <div id="stars"></div>
      </div>
    </div>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
<style is:global>
  :root {
    color-scheme: light dark;
  }
  html {
    font-family: "DM Sans Variable", system-ui, sans-serif;
    font-weight: 300;
    font-style: normal;
    scroll-behavior: smooth;
  }
  body {
    display: flex;
    justify-content: center;
    height: 100%;
    min-height: 100dvh;
    overflow-x: hidden;
    overscroll-behavior: none;
    color: #e1ffff;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
