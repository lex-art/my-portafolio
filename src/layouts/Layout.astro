---
import "@fontsource-variable/inter";
import "../styles.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  keyWords: string;
}

const { title, description, keyWords } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-favicon.png" />
    <link rel="icon" href="/apple-favicon.png" sizes="any" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Oscar Chanax" />
    <meta name="keywords" content={keyWords} />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content="https://alexander-dev.com" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Oscar Chanax | Senior Software Engineer | Tech Lead | Architect"
    />
    <meta
      property="og:description"
      content="Senior Software Engineer especializado en liderazgo técnico y arquitectura. Transformo ideas en soluciones escalables liderando equipos de alto rendimiento."
    />
    <meta
      property="og:image"
      content="https://alexander-dev.com/img/profile-toy.webp"
    />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="alexander-dev.com" />
    <meta property="twitter:url" content="https://alexander-dev.com" />
    <meta
      name="twitter:title"
      content="Oscar Chanax | Senior Software Engineer | Tech Lead"
    />
    <meta
      name="twitter:description"
      content="Senior Software Engineer especializado en liderazgo técnico y arquitectura. Transformo ideas en soluciones escalables liderando equipos de alto rendimiento."
    />
    <meta
      name="twitter:image"
      content="https://alexander-dev.com/img/profile-toy.webp"
    />

    <!-- Meta Tags Generated via https://www.opengraph.xyz -->
    <ClientRouter />
    <script is:inline>
      // Resolve the theme before first paint, so the ground never flashes.
      (() => {
        const stored = localStorage.getItem("theme");
        const isDark =
          stored === "dark" ||
          (stored === null &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  body {
    min-height: 100dvh;
    margin: 0;
    overflow-x: hidden;
    overscroll-behavior: none;
  }
</style>
