---
import SectionContainer from "../components/SectionContainer.astro";
import Layout from "../layouts/Layout.astro";
import About from "../components/locales/es/Sections/About.astro";
import Home from "../components/locales/es/Sections/Home.astro";
import Works from "../components/locales/es/Sections/Works.astro";
import { useI18Translations } from "../i18n/utils";

const { t } = useI18Translations(Astro.url);
---

<Layout
  title={t("common.title")}
  description={t("common.description")}
  keyWords={t("common.keywords")}
>
  <main class="px-4">
    <SectionContainer id="about" width="lg:max-w-6xl md:max-w-2xl">
      <Home />
    </SectionContainer>
    <SectionContainer id="experience" width="lg:max-w-6xl md:max-w-4xl">
      <Works />
    </SectionContainer>
    <SectionContainer id="projects">
      <About />
    </SectionContainer>
  </main>
</Layout>
