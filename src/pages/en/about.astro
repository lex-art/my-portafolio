---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const navigate = useTranslatedPath(lang);
---

<Layout title="About me">
  <section class="mt-20">
    <h1>{t("nav.home")}</h1>
    <a href={navigate("/")} class="text-blue-500">Regresar</a>
  </section>
</Layout>
